FROM python:3.11-slim

# Install git and essential testing tools inside the isolated environment
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sandbox

RUN useradd -m sandboxuser && chown -R sandboxuser:sandboxuser /sandbox
USER sandboxuser

CMD ["bash"]
